{
  "name": "@workspace/api-spec",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "codegen": "orval --config ./orval.config.ts && pnpm -w run typecheck:libs",
    "codegen:phase1": "orval --config ./orval.phase1.config.ts",
    "codegen:documents": "orval --config ./orval.documents.config.ts",
    "codegen:reservations": "orval --config ./orval.reservations.config.ts",
    "codegen:branding": "orval --config ./orval.branding.config.ts",
    "codegen:crm": "orval --config ./orval.crm.config.ts",
    "codegen:wallet": "orval --config ./orval.wallet.config.ts",
    "codegen:delivery": "orval --config ./orval.delivery.config.ts",
    "codegen:timeclock": "orval --config ./orval.timeclock.config.ts",
    "codegen:catalog-admin": "orval --config ./orval.catalog-admin.config.ts",
    "codegen:stamp": "sha256sum ../../lib/api-spec/openapi.yaml | awk '{print $1}' > .codegen-stamp && echo 'Stamp updated'"
  },
  "devDependencies": {
    "orval": "^8.22.0"
  }
}
