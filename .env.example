# ============================================================
# Piccolo TPV — Variables de entorno
# ============================================================
# Este archivo contiene SOLO nombres y valores de ejemplo ficticios.
# No copiar secretos reales aquí.
# Copiar este archivo a .env y rellenar con valores reales.
# ============================================================

# ── Base de datos ────────────────────────────────────────────
# Obligatoria. Cadena de conexión PostgreSQL.
# En Replit: gestionada automáticamente por la integración de DB.
DATABASE_URL=postgresql://user:password@localhost:5432/piccolo_tpv

# ── Autenticación ────────────────────────────────────────────
# Obligatoria. Secreto para firmar JWT (mínimo 32 caracteres aleatorios).
# Cambiar este valor invalida todos los tokens existentes.
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-chars

# Obligatoria durante el primer arranque. Debe tener al menos 32 caracteres
# aleatorios y se elimina del entorno después de crear el primer administrador.
BOOTSTRAP_SECRET=genera-un-secreto-bootstrap-aleatorio-de-al-menos-32-chars

# Identificador interno del restaurante, resuelto por el servidor para aislar
# los rooms de Socket.IO. No es un secreto.
RESTAURANT_ID=restaurante-principal

# ── Servidor ─────────────────────────────────────────────────
# Opcional. Puerto en el que arranca el servidor API.
# En Replit: asignado automáticamente. No sobreescribir manualmente.
PORT=8080

# Opcional. Entorno de ejecución: development | production | test
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────────
# Opcional. Orígenes adicionales permitidos (comma-separated).
# Ya incluidos por defecto: piccolo-tpv.replit.app y REPLIT_DEV_DOMAIN.
ALLOWED_ORIGINS=https://mi-dominio-personalizado.com

# Opcional. Dominio de desarrollo de Replit (inyectado automáticamente en Replit).
REPLIT_DEV_DOMAIN=mi-repl.replit.dev

# ── Stripe (pagos online) ────────────────────────────────────
# Opcional. Solo necesario si se usa el módulo de pagos online con Stripe.
STRIPE_SECRET_KEY=sk_test_51AbCdEfGhIjKlMnOpQrStUvWxYz
STRIPE_WEBHOOK_SECRET=whsec_AbCdEfGhIjKlMnOpQrStUvWxYz

# ── Caja automática (simulador) ──────────────────────────────
# Opcional. Fija el escenario del simulador de caja automática.
# Valores: success | error | timeout | empty
CASH_MACHINE_SCENARIO=success

# ── VeriFactu (simulador AEAT) ───────────────────────────────
# Opcional. Secreto para webhooks del simulador VeriFactu.
# Solo necesario en entornos de prueba con el simulador de la AEAT.
SIMULATOR_WEBHOOK_SECRET=sim-webhook-secret-ejemplo

# ── QR heredado (solo mientras siga desplegado) ──────────────
# Obligatoria para compilar QR Menu en producción.
VITE_CONVEX_URL=https://deployment-ejemplo.convex.cloud
CONVEX_IMPORT_SECRET=genera-un-secreto-de-importacion-aleatorio
# Solo desarrollo: activa datos demo de forma explícita.
QR_MENU_DEMO=false
QR_MENU_ENV=development
DEMO_SEED_SECRET=genera-un-secreto-demo-aleatorio
# Solo desarrollo: habilita la ruta antigua basada en fixtures.
VITE_QR_FIXTURES=false

# ── Notas de entorno ─────────────────────────────────────────
# Desarrollo local:   solo DATABASE_URL y SESSION_SECRET son obligatorias
# Tests (Vitest):     DATABASE_URL apuntando a DB de test + SESSION_SECRET
# Producción:         todas las marcadas como "Obligatoria" + Stripe si aplica
# Replit dev:         DATABASE_URL y SESSION_SECRET gestionadas como Secrets
