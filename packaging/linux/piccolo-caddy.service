[Unit]
Description=Piccolo TPV HTTPS Proxy (Caddy)
After=network-online.target piccolo-api.service
Wants=network-online.target

[Service]
Type=simple
User=piccolo
Group=piccolo
WorkingDirectory=@PICCOLO_DATA_ROOT@
Environment=XDG_DATA_HOME=@PICCOLO_DATA_ROOT@/caddy
ExecStart=@PICCOLO_APP_ROOT@/caddy/caddy run --config @PICCOLO_DATA_ROOT@/config/Caddyfile
Restart=always
RestartSec=5
StandardOutput=append:@PICCOLO_DATA_ROOT@/logs/caddy.log
StandardError=append:@PICCOLO_DATA_ROOT@/logs/caddy.log
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
