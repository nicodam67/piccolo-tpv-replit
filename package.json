{
  "name": "workspace",
  "version": "0.9.0-rc.1",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "lint": "eslint . --max-warnings=0",
    "codegen:phase1:check": "node scripts/check-phase1-codegen.mjs",
    "codegen:documents:check": "node scripts/check-documents-codegen.mjs",
    "codegen:reservations:check": "node scripts/check-reservations-codegen.mjs",
    "codegen:branding:check": "node scripts/check-branding-codegen.mjs",
    "codegen:crm:check": "node scripts/check-crm-codegen.mjs",
    "codegen:wallet:check": "node scripts/check-wallet-codegen.mjs",
    "codegen:catalog-admin:check": "node scripts/check-catalog-admin-codegen.mjs",
    "codegen:cash-payments:check": "node scripts/check-cash-payments-codegen.mjs",
    "migrate:phase1-hooks": "node scripts/migrate-floor-generated-hooks.mjs",
    "migrate:documents-hooks": "node scripts/migrate-documents-generated-hooks.mjs",
    "migrate:reservations-hooks": "node scripts/migrate-reservations-generated-hooks.mjs",
    "migrate:branding-hooks": "node scripts/migrate-branding-generated-hooks.mjs",
    "migrate:crm-hooks": "node scripts/migrate-crm-generated-hooks.mjs",
    "migrate:wallet-hooks": "node scripts/migrate-wallet-generated-hooks.mjs",
    "migrate:catalog-admin-hooks": "node scripts/migrate-catalog-admin-generated-hooks.mjs",
    "migrate:cash-payments-hooks": "node scripts/migrate-cash-payments-generated-hooks.mjs",
    "certify:hardware-readiness": "node scripts/certify-hardware-readiness.mjs",
    "certify:physical-print": "node scripts/certify-physical-print.mjs",
    "release:check-version": "node scripts/check-version-coherence.mjs",
    "release:build-rc": "node scripts/build-release-candidate.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.4",
      "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
      "js-yaml": "^4.3.0",
      "postcss": "8.5.18",
      "vite>esbuild": "0.28.1",
      "uuid": ">=11.1.1"
    }
  }
}
