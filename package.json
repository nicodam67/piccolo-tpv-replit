{
  "name": "workspace",
  "version": "0.9.0-rc.2",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "release:check-version": "node scripts/check-version-coherence.mjs",
    "release:build-rc": "node scripts/build-release-candidate.mjs",
    "release:build-rc-linux": "node scripts/build-release-candidate-linux.mjs",
    "release:render-guide": "node scripts/render-install-guide.mjs",
    "release:build-hardware-package": "node scripts/build-hardware-test-package.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
